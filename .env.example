# Browser-safe Supabase values enable phone OTP login. Configure Phone Auth and an SMS provider in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values enable secure API access and durable persistence. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
